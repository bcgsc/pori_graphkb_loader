FROM python:3.11-slim

WORKDIR /usr/src/app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    POETRY_VIRTUALENVS_CREATE=false

RUN pip install --no-cache-dir "poetry>=2,<3"

COPY python/pyproject.toml python/poetry.lock ./python/

# Needed because loader packages are local path dependencies
COPY python/src ./python/src

WORKDIR /usr/src/app/python

RUN poetry install \
    --only main \
    --all-extras \
    --no-interaction \
    --no-ansi

# Required by fda-approvals
RUN python -m playwright install --with-deps chromium

ENTRYPOINT ["graphkb-loader"]
